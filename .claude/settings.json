{
  "permissions": {
    "deny": [
      "Bash(curl:*)",
      "Bash(wget:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "\"python3\" -I -c \"import os,runpy;p=os.path.join(os.environ.get('CLAUDE_PROJECT_DIR','.'),'tools','hlidac_site.py');os.path.isfile(p) and runpy.run_path(p,run_name='__main__')\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
